# Copy this file to .streamlit/secrets.toml for LOCAL testing only.
# .streamlit/secrets.toml is gitignored on purpose — never commit a real key.
#
# On Streamlit Community Cloud, you do NOT create this file at all. Instead,
# go to your app's Settings > Secrets and paste the same line in there.
# Community Cloud injects it as st.secrets automatically, same as this file
# does locally.
#
# Only the question box and the funder-report summary use this key. The
# dashboard runs without it.

ANTHROPIC_API_KEY = "your-key-here"
